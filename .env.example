# ================================================
# VARIÁVEIS DE AMBIENTE - LUKAYA GRIFFE
# ================================================
# Copie este arquivo para .env e preencha com seus valores
# NÃO commite o arquivo .env com valores reais!
# ================================================

# Supabase Configuration (OBRIGATÓRIO)
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-aqui

# WhatsApp Number (OPCIONAL)
# Número no formato internacional: código do país + DDD + número
# Exemplo: Brasil (55) + DDD (11) + Número (986751552)
VITE_WHATSAPP_NUMBER=5511986751552

# ================================================
# INTEGRAÇÃO COM MARKETPLACES (OPCIONAL)
# ================================================
# Configure as credenciais dos marketplaces que deseja integrar
# Deixe em branco os que não for usar

# Mercado Livre
# Obtenha em: https://developers.mercadolivre.com.br/
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_ACCESS_TOKEN=
MERCADO_LIVRE_REFRESH_TOKEN=

# Shopee
# Obtenha em: https://open.shopee.com/
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=

# TikTok Shop
# Obtenha em: https://partner.tiktokshop.com/
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SHOP_ID=
TIKTOK_ACCESS_TOKEN=

# Amazon SP-API
# Obtenha em: https://sellercentral.amazon.com.br/apps/manage
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_SELLER_ID=
AMAZON_REFRESH_TOKEN=
AMAZON_REGION=us-east-1

# WooCommerce
# Obtenha em: WooCommerce → Configurações → Avançado → API REST
WOOCOMMERCE_URL=https://minhaloja.com
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# ================================================
# NOTAS DE CONFIGURAÇÃO
# ================================================

# Para Desenvolvimento Local:
# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha com suas credenciais
# 3. Execute: npm run dev

# Para Deploy no Easypanel:
# 1. Vá em Settings → Environment Variables
# 2. Adicione cada variável acima
# 3. O Easypanel irá injetá-las automaticamente

# Para Deploy em outras plataformas:
# - Vercel: Settings → Environment Variables
# - Netlify: Site settings → Build & deploy → Environment
# - Cloudflare Pages: Settings → Environment variables

# ⚠️ SEGURANÇA:
# - NUNCA commite o arquivo .env
# - Use valores diferentes para dev/staging/prod
# - Rotacione chaves regularmente
# - Configure RLS no Supabase antes de produção
